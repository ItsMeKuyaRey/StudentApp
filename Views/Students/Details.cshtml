@model StudentApp.Models.Student

@{
    ViewData["Title"] = "Student Details";

    var initial = string.IsNullOrWhiteSpace(Model.FullName)
        ? "S"
        : Model.FullName.Substring(0, 1).ToUpper();
}

<style>
    .student-details-page {
        min-height: calc(100vh - 72px);
        padding: 50px 24px 70px;
        background:
            radial-gradient(circle at 12% 12%, rgba(124, 58, 237, .10), transparent 28%),
            radial-gradient(circle at 90% 85%, rgba(168, 85, 247, .08), transparent 30%),
            #f8f7fc;
    }

    .details-container {
        max-width: 1000px;
        margin: 0 auto;
    }

    .details-top {
        margin-bottom: 28px;
    }

    .details-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: #7c3aed;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 1.8px;
        text-transform: uppercase;
        margin-bottom: 10px;
    }

    .details-eyebrow::before {
        content: "";
        width: 24px;
        height: 3px;
        border-radius: 20px;
        background: linear-gradient(90deg, #7c3aed, #a855f7);
    }

    .details-top h1 {
        margin: 0;
        color: #201a32;
        font-size: 38px;
        font-weight: 800;
        letter-spacing: -1.2px;
    }

    .details-top p {
        margin: 8px 0 0;
        color: #817a91;
        font-size: 14px;
    }

    .profile-card {
        position: relative;
        overflow: hidden;
        border: 1px solid #e9e5f1;
        border-radius: 24px;
        background: white;
        box-shadow: 0 18px 50px rgba(45, 30, 75, .08);
    }

    .profile-banner {
        height: 145px;
        background:
            radial-gradient(circle at 85% 30%, rgba(255,255,255,.24), transparent 22%),
            linear-gradient(135deg, #6d28d9, #8b5cf6 55%, #a855f7);
    }

    .profile-content {
        padding: 0 32px 32px;
    }

    .profile-main {
        display: flex;
        align-items: flex-end;
        gap: 20px;
        margin-top: -55px;
        margin-bottom: 30px;
    }

    .profile-avatar {
        width: 110px;
        height: 110px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border: 7px solid white;
        border-radius: 30px;
        background: linear-gradient(135deg, #eadcff, #f6f1ff);
        color: #7138d8;
        font-size: 36px;
        font-weight: 800;
        box-shadow: 0 10px 25px rgba(65, 40, 110, .14);
    }

    .profile-name h2 {
        margin: 0;
        color: #282137;
        font-size: 25px;
        font-weight: 800;
    }

    .profile-name p {
        margin: 6px 0 0;
        color: #91899f;
        font-size: 12px;
    }

    .profile-id {
        margin-left: auto;
        padding: 8px 12px;
        border-radius: 9px;
        background: #f4efff;
        color: #7542d1;
        font-size: 11px;
        font-weight: 800;
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
        margin-bottom: 28px;
    }

    .info-box {
        padding: 20px;
        border: 1px solid #eeeaf5;
        border-radius: 15px;
        background: #fcfbfe;
    }

    .info-label {
        color: #91899f;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: .8px;
        text-transform: uppercase;
        margin-bottom: 8px;
    }

    .info-value {
        color: #30283c;
        font-size: 16px;
        font-weight: 750;
    }

    .course-value {
        display: inline-flex;
        padding: 7px 11px;
        border-radius: 9px;
        background: #eee5ff;
        color: #7138d8;
        font-size: 12px;
        font-weight: 800;
    }

    .details-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        padding-top: 24px;
        border-top: 1px solid #eeeaf5;
    }

    .details-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 11px 17px;
        border-radius: 10px;
        text-decoration: none;
        font-size: 12px;
        font-weight: 750;
        transition: .2s ease;
    }

    .details-button:hover {
        transform: translateY(-1px);
    }

    .details-button.back {
        background: #f4f2f7;
        color: #625b70;
    }

    .details-button.edit {
        background: linear-gradient(135deg, #7c3aed, #9b5cf6);
        color: white;
        box-shadow: 0 8px 20px rgba(124, 58, 237, .20);
    }

    @@media (max-width: 700px) {
        .student-details-page {
            padding: 30px 15px 50px;
        }

        .profile-content {
            padding: 0 20px 25px;
        }

        .profile-main {
            align-items: flex-start;
            flex-direction: column;
        }

        .profile-id {
            margin-left: 0;
        }

        .info-grid {
            grid-template-columns: 1fr;
        }

        .details-actions {
            justify-content: stretch;
            flex-direction: column;
        }
    }
</style>

<div class="student-details-page">
    <div class="details-container">

        <div class="details-top">
            <div class="details-eyebrow">Student Profile</div>
            <h1>Student Details</h1>
            <p>View the complete information for this student.</p>
        </div>

        <section class="profile-card">

            <div class="profile-banner"></div>

            <div class="profile-content">

                <div class="profile-main">

                    <div class="profile-avatar">
                        @initial
                    </div>

                    <div class="profile-name">
                        <h2>@Model.FullName</h2>
                        <p>Registered Student</p>
                    </div>

                    <div class="profile-id">
                        ID #@Model.Id
                    </div>

                </div>

                <div class="info-grid">

                    <div class="info-box">
                        <div class="info-label">Student ID</div>
                        <div class="info-value">#@Model.Id</div>
                    </div>

                    <div class="info-box">
                        <div class="info-label">Age</div>
                        <div class="info-value">@Model.Age years old</div>
                    </div>

                    <div class="info-box">
                        <div class="info-label">Course</div>
                        <div class="course-value">@Model.Course</div>
                    </div>

                </div>

                <div class="details-actions">

                    <a asp-action="Index" class="details-button back">
                        Back to Students
                    </a>

                    <a asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="details-button edit">
                        Edit Student
                    </a>

                </div>

            </div>

        </section>

    </div>
</div>