@model StudentApp.Models.Student

@{
    ViewData["Title"] = "Edit Student";

    var initial = string.IsNullOrWhiteSpace(Model.FullName)
        ? "S"
        : Model.FullName.Substring(0, 1).ToUpper();
}

<style>
    .edit-page {
        min-height: calc(100vh - 72px);
        padding: 50px 24px 70px;
        background:
            radial-gradient(circle at 15% 10%, rgba(139, 92, 246, .10), transparent 28%),
            radial-gradient(circle at 90% 85%, rgba(168, 85, 247, .08), transparent 30%),
            #f8f7fc;
    }

    .edit-container {
        max-width: 900px;
        margin: 0 auto;
    }

    .edit-header {
        margin-bottom: 28px;
    }

    .edit-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: #7c3aed;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 1.8px;
        text-transform: uppercase;
        margin-bottom: 10px;
    }

    .edit-eyebrow::before {
        content: "";
        width: 24px;
        height: 3px;
        border-radius: 20px;
        background: linear-gradient(90deg, #7c3aed, #a855f7);
    }

    .edit-header h1 {
        margin: 0;
        color: #201a32;
        font-size: 38px;
        font-weight: 800;
        letter-spacing: -1.2px;
    }

    .edit-header p {
        margin: 8px 0 0;
        color: #817a91;
        font-size: 14px;
    }

    .edit-card {
        overflow: hidden;
        border: 1px solid #e9e5f1;
        border-radius: 24px;
        background: white;
        box-shadow: 0 18px 50px rgba(45, 30, 75, .08);
    }

    .edit-card-top {
        display: flex;
        align-items: center;
        gap: 17px;
        padding: 26px 30px;
        background: linear-gradient(135deg, #faf7ff, #f5efff);
        border-bottom: 1px solid #eeeaf5;
    }

    .edit-avatar {
        width: 58px;
        height: 58px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 16px;
        background: linear-gradient(135deg, #eadcff, #f5efff);
        color: #7138d8;
        font-size: 20px;
        font-weight: 800;
    }

    .edit-card-top h2 {
        margin: 0;
        color: #2d263b;
        font-size: 17px;
        font-weight: 800;
    }

    .edit-card-top span {
        display: block;
        margin-top: 4px;
        color: #938c9e;
        font-size: 11px;
    }

    .edit-form {
        padding: 32px;
    }

    .field {
        margin-bottom: 22px;
    }

    .field label {
        display: block;
        margin-bottom: 8px;
        color: #40384d;
        font-size: 12px;
        font-weight: 750;
    }

    .field input {
        width: 100%;
        height: 46px;
        box-sizing: border-box;
        padding: 0 14px;
        border: 1px solid #e3deeb;
        border-radius: 11px;
        outline: none;
        background: #fcfbfe;
        color: #30283c;
        font-size: 13px;
        transition: .2s ease;
    }

    .field input:focus {
        background: white;
        border-color: #a78bfa;
        box-shadow: 0 0 0 4px rgba(124, 58, 237, .08);
    }

    .field input.input-validation-error {
        border-color: #dc3545;
    }

    .field-validation-error {
        display: block;
        margin-top: 6px;
        color: #d24c63;
        font-size: 11px;
    }

    .edit-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        padding-top: 10px;
    }

    .edit-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 42px;
        padding: 0 18px;
        border-radius: 10px;
        border: none;
        text-decoration: none;
        font-size: 12px;
        font-weight: 750;
        cursor: pointer;
        transition: .2s ease;
    }

    .edit-button:hover {
        transform: translateY(-1px);
    }

    .edit-button.cancel {
        background: #f4f2f7;
        color: #625b70;
    }

    .edit-button.save {
        background: linear-gradient(135deg, #7c3aed, #9b5cf6);
        color: white;
        box-shadow: 0 8px 20px rgba(124, 58, 237, .20);
    }

    @@media (max-width: 600px) {
        .edit-page {
            padding: 30px 15px 50px;
        }

        .edit-form {
            padding: 24px 20px;
        }

        .edit-card-top {
            padding: 22px 20px;
        }

        .edit-actions {
            flex-direction: column-reverse;
        }

        .edit-button {
            width: 100%;
        }
    }
</style>

<div class="edit-page">
    <div class="edit-container">

        <div class="edit-header">
            <div class="edit-eyebrow">Student Management</div>
            <h1>Edit Student</h1>
            <p>Update the student's information below.</p>
        </div>

        <section class="edit-card">

            <div class="edit-card-top">

                <div class="edit-avatar">
                    @initial
                </div>

                <div>
                    <h2>@Model.FullName</h2>
                    <span>Student ID #@Model.Id</span>
                </div>

            </div>

            <form asp-action="Edit" method="post" class="edit-form">

                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly"
                     class="field-validation-error">
                </div>

                <div class="field">
                    <label asp-for="FullName">Full Name</label>
                    <input asp-for="FullName" />
                    <span asp-validation-for="FullName"></span>
                </div>

                <div class="field">
                    <label asp-for="Age">Age</label>
                    <input asp-for="Age" type="number" />
                    <span asp-validation-for="Age"></span>
                </div>

                <div class="field">
                    <label asp-for="Course">Course</label>
                    <input asp-for="Course" />
                    <span asp-validation-for="Course"></span>
                </div>

                <div class="edit-actions">

                    <a asp-action="Index"
                       class="edit-button cancel">
                        Cancel
                    </a>

                    <button type="submit"
                            class="edit-button save">
                        Save Changes
                    </button>

                </div>

            </form>

        </section>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}